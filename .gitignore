# ============================================================
# Aurora Application .gitignore
# 覆盖范围：C# / .NET、Vue/TypeScript、Python 工具、Windows/macOS 系统文件
# ============================================================

# ------------------------------------------------------------
# .NET / C# / Visual Studio
# ------------------------------------------------------------
bin/
obj/
Builds/
Publish/
*.user
*.suo
*.vshost.*
*.csproj.user
*.csproj.vspscc
*.vbproj.user
*.vbproj.vspscc
# 注意：不忽略 *.sln / *.slnx，这些是解决方案文件，需要提交
.vs/
TestResults/
*.coverage
coverage/
*.tmp
*.temp

# NuGet
packages/
.nuget/
*.nupkg

# 符号文件（调试用，体积大，不纳入版本控制）
*.pdb
*.ilk
*.exp
*.idb

# ------------------------------------------------------------
# Vue / Node.js / TypeScript
# ------------------------------------------------------------
node_modules/
dist/
dist-ssr/

# TypeScript 增量编译缓存
*.tsbuildinfo

# npm / yarn / pnpm 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 可选缓存
.npm/
.eslintcache
.stylelintcache
.nyc_output/
*.lcov

# Yarn Berry（保留配置，忽略缓存）
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# 本地环境覆盖（*.local 优先级最高，不应提交）
*.local

# ------------------------------------------------------------
# VS Code（保留团队共享的配置）
# ------------------------------------------------------------
# 忽略目录内容而非目录本身，这样 ! 白名单才能生效
# 若忽略 .vscode/ 整个目录，则 !.vscode/extensions.json 不会生效
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ------------------------------------------------------------
# Python 工具脚本（Tools/ 目录）
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.spec
pip-log.txt
.Python
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Python 虚拟环境（如果在项目目录下创建的话）
.venv/
venv/
env/

# ------------------------------------------------------------
# 日志文件
# ------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------
# Windows 系统文件
# ------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ------------------------------------------------------------
# macOS 系统文件
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ------------------------------------------------------------
# 编辑器通用临时文件
# ------------------------------------------------------------
*.swp
*.swo
*.bak
*~
.history/
