<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\..\common.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Linux ARM64 平台条件编译定义 -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
        <DefineConstants>$(DefineConstants);RUNTIME_LINUX</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\AuroraStruct3D.Domain\AuroraStruct3D.Domain.csproj" />
        <ProjectReference Include="..\..\AuroraAbpPro\Volo.Abp.Core\Volo.Abp.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\AuroraAbpPro\Volo.Abp.BackgroundJobs.HangFire\Volo.Abp.BackgroundJobs.HangFire.csproj" />
    </ItemGroup>

    <!-- 图像编码：BMP 帧输出 -->
    <ItemGroup>
        <PackageReference Include="SkiaSharp" Version="3.119.0" />
        <PackageReference
            Include="SkiaSharp.NativeAssets.Linux"
            Version="3.119.0"
            Condition="'$(RuntimeIdentifier)' == 'linux-arm64'"
        />
        <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    </ItemGroup>

    <!-- Windows x64 平台：复制 x64_all 下全部运行时文件（含 GenApi / OnnxRuntime 等依赖） -->
    <ItemGroup Condition="Exists('C:\Program Files (x86)\TUCam_SDK\runtime\x64_all') AND '$(Platform)' != 'x86'">
        <None Include="C:\Program Files (x86)\TUCam_SDK\runtime\x64_all\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Windows x86 平台：复制 x86 目录下全部运行时文件 -->
    <ItemGroup Condition="Exists('C:\Program Files (x86)\TUCam_SDK\runtime\x86') AND '$(Platform)' == 'x86'">
        <None Include="C:\Program Files (x86)\TUCam_SDK\runtime\x86\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Linux ARM64 平台：复制 TUCam_aarch64 下全部运行时共享库（含 GenICam 依赖） -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
        <None Include="$(MSBuildThisFileDirectory)..\..\..\Documents\TUCam_aarch64\lib\*.so*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(Filename)%(Extension)</TargetPath>
        </None>
        <None Include="$(MSBuildThisFileDirectory)..\..\..\Documents\TUCam_aarch64\lib\CtiConfig.ini">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(Filename)%(Extension)</TargetPath>
        </None>
    </ItemGroup>
</Project>
