# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# vue-router 的模式
VITE_ROUTER_HISTORY=history


# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true

# 是否打开刷新浏览器检查用户角色信息
VITE_REFRESH_ROLE = true

# 后端接口地址
VITE_APP_API_ADDRESS=http://139.155.114.244:44315

# websocket地址
VITE_WEBSOCKET_URL=http://139.155.114.244:44315/signalr/notification
