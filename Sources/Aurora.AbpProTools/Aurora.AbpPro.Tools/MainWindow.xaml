<hc:Window
    x:Class="Aurora.AbpPro.Tools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource Lang.AppTitle}"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="600"
    Background="{DynamicResource SecondaryRegionBrush}"
    Icon="/Aurora.AbpPro.Tools;component/Assets/AuroraApplication.ico"
    ResizeMode="CanResizeWithGrip"
    ShowTitle="False"
    Style="{StaticResource WindowWin10}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
>
    <!--  顶部非客户区（标题栏区域）：左侧标题+版本号；右侧设置齿轮按钮（点击弹出主题与语言选择）  -->
    <hc:Window.NonClientAreaContent>
        <Grid Height="29">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  标题区：标题 + 版本号 Badge  -->
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Text="{Binding Title}"
                />
                <Border
                    Margin="10,0,0,0"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SecondaryRegionBrush}"
                    CornerRadius="2"
                >
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="{Binding Version}"
                    />
                </Border>
            </StackPanel>

            <!--  右侧：设置按钮 + 弹出面板  -->
            <Grid Grid.Column="1">
                <Button
                    x:Name="ButtonConfig"
                    hc:IconElement.Geometry="{StaticResource ConfigGeometry}"
                    Click="ButtonConfig_OnClick"
                    Foreground="{DynamicResource PrimaryTextBrush}"
                    Style="{StaticResource ButtonIcon}"
                    ToolTip="{DynamicResource Lang.Toolbar.Settings}"
                />
                <Popup
                    x:Name="PopupConfig"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ButtonConfig}"
                    StaysOpen="False"
                >
                    <Border
                        Margin="16"
                        Background="{DynamicResource SecondaryRegionBrush}"
                        CornerRadius="4"
                        Effect="{StaticResource EffectShadow2}"
                    >
                        <StackPanel Orientation="Horizontal">
                            <!--  语言选择：图标按钮 + Tag 触发  -->
                            <StackPanel Margin="10" Button.Click="ButtonLangs_OnClick">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{DynamicResource Lang.Toolbar.Language}"
                                />
                                <Button
                                    Margin="0,0,0,8"
                                    Style="{StaticResource ButtonCustom}"
                                    Tag="zh-CN"
                                    ToolTip="简体中文"
                                >
                                    <Image
                                        Width="32"
                                        Source="pack://application:,,,/Aurora.AbpPro.Tools;component/Resources/Img/Flag/cn.png"
                                    />
                                </Button>
                                <Button
                                    Style="{StaticResource ButtonCustom}"
                                    Tag="en-US"
                                    ToolTip="English"
                                >
                                    <Image
                                        Width="32"
                                        Source="pack://application:,,,/Aurora.AbpPro.Tools;component/Resources/Img/Flag/en.png"
                                    />
                                </Button>
                            </StackPanel>

                            <hc:Divider
                                Margin="0,20"
                                LineStrokeDashArray="2,2"
                                LineStrokeThickness="1"
                                Orientation="Vertical"
                            />

                            <!--  主题选择：用按钮 + Tag 触发  -->
                            <StackPanel Margin="10" Button.Click="ButtonSkins_OnClick">
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    Text="{DynamicResource Lang.Toolbar.Theme}"
                                />
                                <Button Style="{StaticResource ButtonCustom}" Tag="Default">
                                    <Border
                                        Width="48"
                                        Height="22"
                                        Background="White"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                    />
                                </Button>
                                <Button
                                    Margin="0,8,0,0"
                                    Style="{StaticResource ButtonCustom}"
                                    Tag="Dark"
                                >
                                    <Border
                                        Width="48"
                                        Height="22"
                                        Background="Black"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                    />
                                </Button>
                                <Button
                                    Margin="0,8,0,0"
                                    Style="{StaticResource ButtonCustom}"
                                    Tag="Violet"
                                >
                                    <Border
                                        Width="48"
                                        Height="22"
                                        Background="DarkViolet"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                    />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </hc:Window.NonClientAreaContent>

    <!--  主体区域：仿照 HandyControl Demo 的折叠侧边栏布局；背景使用云朵图案画刷  -->
    <Grid Background="{StaticResource CloudDrawingBrush}">
        <Grid.ColumnDefinitions>
            <!--  左侧菜单：可拖拽缩放，并通过按钮折叠/展开  -->
            <ColumnDefinition
                x:Name="ColumnDefinitionLeft"
                Width="220"
                MinWidth="180"
                MaxWidth="320"
            />
            <!--  右侧页面容器  -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!--  右侧页面容器：声明在按钮之后，按 Z-Order 自然覆盖按钮的右半部分  -->
        <Border
            x:Name="MainContent"
            Grid.Column="2"
            Margin="12"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="8"
            Effect="{StaticResource EffectShadow2}"
        >
            <ContentControl Margin="16" Content="{Binding CurrentPage}" />
        </Border>

        <!--  折叠按钮：放在右列内、左对齐，按钮中心刚好落在右 Border 左边缘；声明在 MainContent 之前，渲染顺序让右 Border 盖住按钮右半  -->
        <Button
            x:Name="ButtonShiftOut"
            Margin="0,26,-2,0"
            Padding="8,8,0,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            hc:IconElement.Geometry="{StaticResource LeftGeometry}"
            Click="OnLeftMainContentShiftOut"
            Style="{StaticResource ButtonIconCircular}"
        />
        <!--  左侧菜单容器：声明在 MainContent 之后，让左侧 Border 同样压住按钮的左半  -->

        <Border
            x:Name="LeftMainContent"
            Grid.Column="0"
            Margin="12"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="8"
            Effect="{StaticResource EffectShadow2}"
        >
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <ListBox
                x:Name="MenuListBox"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Menus}"
                SelectedItem="{Binding SelectedMenu, Mode=TwoWay}"
            >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,8" Orientation="Horizontal">
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                Text="{Binding DisplayName}"
                            />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--  展开按钮：折叠后左列宽=0，按钮放在 Column=1（占满整个窗口）+ 左对齐贴窗口左缘；MainContent 同样在 Column=1 且 Margin=12，会盖住按钮右半，露出左半形成"半身嵌入"  -->
        <Button
            x:Name="ButtonShiftIn"
            Grid.Column="1"
            Margin="-13,26,0,0"
            Padding="8,8,0,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            hc:IconElement.Geometry="{StaticResource RightGeometry}"
            Click="OnLeftMainContentShiftIn"
            Style="{StaticResource ButtonIconCircular}"
            ToolTip="{DynamicResource Lang.Toolbar.Expand}"
            Visibility="Collapsed"
        />
    </Grid>
</hc:Window>
