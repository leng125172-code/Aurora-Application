<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
>
    <!--  中文（简体）资源  -->
    <sys:String x:Key="Lang.AppTitle">Aurora AbpPro 工具集</sys:String>
    <sys:String x:Key="Lang.Menu.Home">主页</sys:String>
    <sys:String x:Key="Lang.Menu.Framework">框架</sys:String>
    <sys:String x:Key="Lang.Menu.Project">项目</sys:String>
    <sys:String x:Key="Lang.Menu.Settings">配置</sys:String>

    <sys:String x:Key="Lang.Toolbar.Theme">主题</sys:String>
    <sys:String x:Key="Lang.Toolbar.Language">语言</sys:String>
    <sys:String x:Key="Lang.Toolbar.Collapse">收起侧边栏</sys:String>
    <sys:String x:Key="Lang.Toolbar.Expand">展开侧边栏</sys:String>
    <sys:String x:Key="Lang.Toolbar.Settings">设置</sys:String>
    <sys:String x:Key="Lang.Toolbar.Theme.Default">浅色</sys:String>
    <sys:String x:Key="Lang.Toolbar.Theme.Dark">深色</sys:String>
    <sys:String x:Key="Lang.Toolbar.Theme.Violet">紫色</sys:String>

    <sys:String x:Key="Lang.Home.Welcome">欢迎使用 Aurora AbpPro 工具集</sys:String>
    <sys:String x:Key="Lang.Home.Description"
        >基于 WPF + Generic Host + HandyControl + NLog 构建的模块化工具集，帮你快速创建、维护 Aurora 解决方案。</sys:String
    >

    <sys:String x:Key="Lang.Framework.Title">框架管理</sys:String>
    <sys:String x:Key="Lang.Framework.Description"
        >在此创建、更新与维护 Aurora 框架模板。</sys:String
    >

    <sys:String x:Key="Lang.Project.Title">项目管理</sys:String>
    <sys:String x:Key="Lang.Project.Description">在此创建并管理基于 Aurora 的应用项目。</sys:String>

    <sys:String x:Key="Lang.Settings.Title">配置中心</sys:String>
    <sys:String x:Key="Lang.Settings.LogTitle">实时日志</sys:String>
    <sys:String x:Key="Lang.Settings.GitHubToken">GitHub Token：</sys:String>
    <sys:String x:Key="Lang.Settings.GitHubToken.Hint">输入后自动保存到本地</sys:String>
    <sys:String x:Key="Lang.Settings.ClearLog">清空日志</sys:String>
    <sys:String x:Key="Lang.Settings.WriteTestLog">写入测试日志</sys:String>

    <sys:String x:Key="Lang.Settings.Filter.From">起始时间</sys:String>
    <sys:String x:Key="Lang.Settings.Filter.To">结束时间</sys:String>
    <sys:String x:Key="Lang.Settings.Filter.Level">级别</sys:String>
    <sys:String x:Key="Lang.Settings.Filter.Keyword">关键字</sys:String>
    <sys:String x:Key="Lang.Settings.Filter.Reset">重置</sys:String>

    <sys:String x:Key="Lang.Settings.Col.Time">时间</sys:String>
    <sys:String x:Key="Lang.Settings.Col.Level">级别</sys:String>
    <sys:String x:Key="Lang.Settings.Col.Logger">来源</sys:String>
    <sys:String x:Key="Lang.Settings.Col.Message">消息</sys:String>
</ResourceDictionary>
