<Window
    x:Class="Aurora.AbpPro.Tools.Pages.FrameworkGenerateResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="生成框架 - 结果报告"
    Width="900"
    Height="600"
    WindowStartupLocation="CenterScreen"
    Background="#1E1E1E"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部：状态摘要  -->
        <Border Grid.Row="0" Background="{Binding HeaderBrush}" Padding="16,12">
            <StackPanel>
                <TextBlock
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding HeaderText}"
                />
                <TextBlock Margin="0,4,0,0" Foreground="#E0FFFFFF" Text="{Binding SummaryText}" />
            </StackPanel>
        </Border>

        <!--  中部：详细消息  -->
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
        >
            <TextBox
                Margin="12"
                Background="#252526"
                BorderThickness="0"
                FontFamily="Consolas"
                FontSize="12"
                Foreground="#D0D0D0"
                IsReadOnly="True"
                Text="{Binding DetailText, Mode=OneWay}"
                TextWrapping="NoWrap"
            />
        </ScrollViewer>

        <!--  底部：操作  -->
        <Border
            Grid.Row="2"
            Background="#252526"
            Padding="12,8"
            BorderBrush="#3F3F46"
            BorderThickness="0,1,0,0"
        >
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="14,4"
                    Click="OnOpenSlnxClick"
                    Content="打开 slnx 所在文件夹"
                />
                <Button Padding="14,4" Click="OnCloseClick" Content="关闭" IsCancel="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
