<UserControl
    x:Class="Aurora.AbpPro.Tools.Pages.FrameworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:vm="clr-namespace:Aurora.AbpPro.Tools.ViewModels"
    Loaded="OnLoadedHandler"
>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题 + 操作区  -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                Text="{DynamicResource Lang.Framework.Title}"
                FontSize="22"
                FontWeight="Bold"
                Foreground="{DynamicResource PrimaryTextBrush}"
                VerticalAlignment="Center"
            />
            <Button
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonSuccess}"
                Command="{Binding BuildFrameworkCommand}"
                Content="生成框架"
            />
            <Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Style="{StaticResource ButtonWarning}"
                Command="{Binding ReadFrameworkCommand}"
                Content="读取框架"
            />
            <Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Style="{StaticResource ButtonPrimary}"
                Command="{Binding DownloadFrameworkCommand}"
                Content="下载框架"
            />
            <Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Style="{StaticResource ButtonDefault}"
                Command="{Binding RefreshAllCommand}"
                Content="刷新全部"
            />
            <Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Style="{StaticResource ButtonDefault}"
                Command="{Binding OpenDownloadFolderCommand}"
                Content="打开下载文件夹"
            />
        </DockPanel>

        <TextBlock
            Grid.Row="1"
            Text="{DynamicResource Lang.Framework.Description}"
            Margin="0,8,0,16"
            TextWrapping="Wrap"
            Foreground="{DynamicResource ThirdlyTextBrush}"
        />

        <!--  仓库卡片列表（自动换行布局）  -->
        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            hc:ScrollViewer.IsInertiaEnabled="True"
        >
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:RepositoryReleaseItem}">
                        <hc:Card
                            Margin="8"
                            Width="320"
                            BorderThickness="0"
                            Effect="{StaticResource EffectShadow2}"
                        >
                            <hc:Card.Header>
                                <Grid Margin="14,12,14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                        />
                                        <TextBlock
                                            Text="{Binding Description}"
                                            Margin="0,4,0,0"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                        />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource PrimaryBrush}"
                                        CornerRadius="9"
                                        Padding="8,2"
                                    >
                                        <TextBlock
                                            Text="{Binding TypeText}"
                                            FontSize="11"
                                            Foreground="White"
                                        />
                                    </Border>
                                </Grid>
                            </hc:Card.Header>

                            <Grid MinHeight="180">
                                <!--  正常内容区域  -->
                                <StackPanel
                                    Margin="14,4,14,12"
                                    Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityReConverter}}"
                                >
                                    <!--  错误信息（仅在出错时显示）  -->
                                    <Border
                                        Background="#22FF5252"
                                        BorderBrush="#FF5252"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="8,6"
                                        Margin="0,0,0,8"
                                        Visibility="{Binding ErrorMessage, Converter={StaticResource String2VisibilityConverter}}"
                                    >
                                        <TextBlock
                                            Text="{Binding ErrorMessage}"
                                            Foreground="#D32F2F"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                        />
                                    </Border>

                                    <!--  最新版本概要  -->
                                    <TextBlock
                                        Text="最新版本"
                                        FontSize="12"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                    />
                                    <TextBlock
                                        Text="{Binding LatestTag}"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource PrimaryBrush}"
                                    />
                                    <TextBlock
                                        Text="{Binding LatestName}"
                                        FontSize="12"
                                        Margin="0,2,0,0"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                    />
                                    <TextBlock
                                        Text="{Binding PublishedAt}"
                                        FontSize="11"
                                        Margin="0,2,0,8"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                    />

                                    <!--  实际使用版本（依赖链推导出的真实下载版本）  -->
                                    <StackPanel
                                        Margin="0,0,0,8"
                                        Visibility="{Binding UsedVersion, Converter={StaticResource String2VisibilityConverter}}"
                                    >
                                        <TextBlock
                                            Text="实际使用版本"
                                            FontSize="12"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                        />
                                        <TextBlock
                                            Text="{Binding UsedVersion}"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Margin="0,2,0,0"
                                            Foreground="{DynamicResource SuccessBrush}"
                                        />
                                    </StackPanel>

                                    <!--  历史版本列表  -->
                                    <Separator Margin="0,4" />
                                    <TextBlock
                                        Text="近期版本"
                                        FontSize="12"
                                        Margin="0,0,0,4"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                    />
                                    <ItemsControl ItemsSource="{Binding RecentReleases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ReleaseSummary}">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Text="{Binding TagName}"
                                                        FontSize="12"
                                                        TextTrimming="CharacterEllipsis"
                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                    />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding PublishedAt}"
                                                        FontSize="11"
                                                        Margin="8,0,0,0"
                                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                                    />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--  操作区：进度条 + 刷新  -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar
                                            Grid.Column="0"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding DownloadProgress}"
                                            IsIndeterminate="{Binding ShowIndeterminate}"
                                        />
                                        <Button
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ButtonDefault}"
                                            Content="刷新"
                                            Command="{Binding DataContext.RefreshItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                        />
                                    </Grid>

                                    <!--  下载状态文本  -->
                                    <TextBlock
                                        Text="{Binding DownloadStatus}"
                                        FontSize="11"
                                        Margin="0,6,0,0"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource ThirdlyTextBrush}"
                                        Visibility="{Binding DownloadStatus, Converter={StaticResource String2VisibilityConverter}}"
                                    />
                                </StackPanel>

                                <!--  加载中遮罩  -->
                                <Border
                                    Background="#80FFFFFF"
                                    Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}"
                                >
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                    >
                                        <hc:LoadingCircle />
                                        <TextBlock
                                            Text="加载中..."
                                            FontSize="12"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource ThirdlyTextBrush}"
                                        />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </hc:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
