<?xml version="1.0" encoding="utf-8" ?>
<!--
  NLog 配置文件
  功能：
    1. 输出到本地日志文件（按日期分割）
    2. 输出到 Visual Studio 调试窗口
    3. 输出到自定义 UI Sink，便于配置页实时显示
-->
<nlog
    xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    autoReload="true"
    throwConfigExceptions="true"
    internalLogLevel="Off"
>
    <!-- 自定义扩展程序集（UI Sink Target） -->
    <extensions>
        <add assembly="Aurora.AbpPro.Tools" />
    </extensions>

    <!-- 输出目标 -->
    <targets async="true">
        <!-- 文件目标：按天分割，最多保留 30 天 -->
        <target
            xsi:type="File"
            name="fileTarget"
            fileName="${basedir}/Logs/${shortdate}.log"
            layout="${longdate} | ${level:uppercase=true:padding=-5} | ${logger} | ${message} ${exception:format=tostring}"
            archiveEvery="Day"
            maxArchiveFiles="30"
            encoding="utf-8"
        />

        <!-- 调试器目标 -->
        <target
            xsi:type="Debugger"
            name="debuggerTarget"
            layout="${time} | ${level:uppercase=true:padding=-5} | ${logger:shortName=true} | ${message} ${exception:format=tostring}"
        />

        <!-- UI 目标：写入 IUiLogSink，供配置页订阅展示 -->
        <target
            xsi:type="UiLogSink"
            name="uiTarget"
            layout="${time} | ${level:uppercase=true:padding=-5} | ${message}"
        />
    </targets>

    <!-- 日志路由规则 -->
    <rules>
        <logger name="Microsoft.*" maxLevel="Info" final="true" />
        <logger name="System.Net.Http.*" maxLevel="Info" final="true" />
        <logger name="*" minlevel="Trace" writeTo="fileTarget,debuggerTarget,uiTarget" />
    </rules>
</nlog>
