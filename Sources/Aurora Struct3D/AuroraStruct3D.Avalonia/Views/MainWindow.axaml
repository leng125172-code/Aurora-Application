<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AuroraStruct3D.Avalonia.ViewModels"
        x:Class="AuroraStruct3D.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="16,8">
            <TextBlock Text="{Binding Title}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="White" />
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1" Margin="16">
            <TextBlock Text="Aurora Struct3D - Avalonia MVVM 桌面客户端"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="24" />
        </Grid>
    </Grid>
</Window>
