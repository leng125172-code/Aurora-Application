@page
@using Lion.AbpPro
@model AuroraCV.Pages.Monitor

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aurora CV Engine - 监控面板</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="/css/aurora-fonts.css" />
    <style>
        /* ==================== CSS 变量 ==================== */
        :root {
            --bg-body: #f0f2f5;
            --bg-sidebar: #ffffff;
            --bg-topbar: rgba(255,255,255,0.85);
            --bg-content: #f5f7fa;
            --bg-card: #ffffff;
            --text-primary: #1a1a2e;
            --text-secondary: #6b7280;
            --text-muted: #9ca3af;
            --border-color: #e5e7eb;
            --accent: #6366f1;
            --accent-light: #818cf8;
            --accent-glow: rgba(99,102,241,0.12);
            --sidebar-w: 240px;
            --topbar-h: 52px;
            --nav-hover: #f5f3ff;
            --nav-active-bg: linear-gradient(135deg, #6366f1, #8b5cf6);
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
            --radius: 10px;
            /* Dashboard 卡片 */
            --stat-bg: #f9fafb;
        }

        [data-theme="dark"] {
            --bg-body: #0f0f23;
            --bg-sidebar: #16213e;
            --bg-topbar: rgba(22,33,62,0.9);
            --bg-content: #0f0f23;
            --bg-card: #1a1a2e;
            --text-primary: #e2e8f0;
            --text-secondary: #94a3b8;
            --text-muted: #64748b;
            --border-color: #2d2d44;
            --accent: #818cf8;
            --accent-light: #a78bfa;
            --accent-glow: rgba(129,140,248,0.15);
            --nav-hover: rgba(129,140,248,0.08);
            --nav-active-bg: linear-gradient(135deg, #6366f1, #8b5cf6);
            --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
            --shadow-md: 0 4px 16px rgba(0,0,0,0.4);
            --stat-bg: #16213e;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
            line-height: 1.5;
            background: var(--bg-body);
            color: var(--text-primary);
            height: 100vh;
            overflow: hidden;
            display: flex;
            transition: background 0.3s, color 0.3s;
        }

        /* ==================== 侧边栏 ==================== */
        .sidebar {
            width: var(--sidebar-w);
            height: 100vh;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            transition: background 0.3s, border 0.3s;
            z-index: 50;
        }

        .sidebar-brand {
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            padding: 0 20px;
            gap: 10px;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }

        .sidebar-brand .brand-icon {
            width: 32px; height: 32px;
            background: var(--nav-active-bg);
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .sidebar-brand .brand-icon i { color: #fff; font-size: 14px; }

        .sidebar-brand span {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .sidebar-nav {
            flex: 1;
            padding: 16px 12px;
            overflow-y: auto;
        }

        .nav-section-title {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 8px 12px 6px;
            margin-top: 8px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            border-radius: var(--radius);
            cursor: pointer;
            transition: all 0.2s ease;
            color: var(--text-secondary);
            font-size: 13.5px;
            font-weight: 500;
            text-decoration: none;
            margin-bottom: 2px;
            user-select: none;
        }

        .nav-item:hover {
            background: var(--nav-hover);
            color: var(--accent);
        }

        .nav-item.active {
            background: var(--nav-active-bg);
            color: #fff;
            box-shadow: 0 4px 12px var(--accent-glow);
        }

        .nav-item i { width: 18px; text-align: center; font-size: 14px; }

        /* ==================== 主内容区 ==================== */
        .main-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* 顶栏 */
        .topbar {
            height: var(--topbar-h);
            background: var(--bg-topbar);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            flex-shrink: 0;
            transition: background 0.3s;
        }

        .topbar-title {
            font-size: 15px;
            font-weight: 600;
            color: var(--text-primary);
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .tb-btn {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            border-radius: 8px;
            padding: 6px 12px;
            font-size: 12.5px;
            cursor: pointer;
            display: flex; align-items: center; gap: 5px;
            transition: all 0.2s;
        }

        .tb-btn:hover {
            color: var(--accent);
            border-color: var(--accent);
            background: var(--accent-glow);
        }

        /* 内容区 */
        .content-area {
            flex: 1;
            position: relative;
            overflow: hidden;
        }

        .content-panel {
            position: absolute; inset: 0;
            display: none;
            background: var(--bg-content);
        }

        .content-panel.active { display: flex; flex-direction: column; }

        .content-panel iframe {
            flex: 1; border: none; width: 100%; height: 100%;
            background: var(--bg-content);
        }

        /* ==================== Dashboard 页面 ==================== */
        .dashboard-wrap {
            flex: 1;
            padding: 24px;
            overflow-y: auto;
        }

        .dash-header {
            margin-bottom: 24px;
        }

        .dash-header h2 {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .dash-header p {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 20px;
            transition: all 0.25s;
            box-shadow: var(--shadow-sm);
        }

        .stat-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .stat-card .stat-icon {
            width: 40px; height: 40px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            margin-bottom: 12px;
        }

        .stat-card .stat-icon.cpu { background: rgba(99,102,241,0.1); color: #6366f1; }
        .stat-card .stat-icon.mem { background: rgba(16,185,129,0.1); color: #10b981; }
        .stat-card .stat-icon.disk { background: rgba(245,158,11,0.1); color: #f59e0b; }
        .stat-card .stat-icon.net { background: rgba(59,130,246,0.1); color: #3b82f6; }
        .stat-card .stat-icon.os { background: rgba(168,85,247,0.1); color: #a855f7; }
        .stat-card .stat-icon.uptime { background: rgba(236,72,153,0.1); color: #ec4899; }

        .stat-card .stat-label {
            font-size: 12px; font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-card .stat-value {
            font-size: 22px; font-weight: 700;
            color: var(--text-primary);
            margin-top: 4px;
        }

        .stat-card .stat-sub {
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        /* 进度条 */
        .progress-bar-wrap {
            width: 100%; height: 6px;
            background: var(--stat-bg);
            border-radius: 3px;
            margin-top: 10px;
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.6s ease;
        }

        .progress-bar-fill.cpu-bar { background: linear-gradient(90deg, #6366f1, #818cf8); }
        .progress-bar-fill.mem-bar { background: linear-gradient(90deg, #10b981, #34d399); }
        .progress-bar-fill.disk-bar { background: linear-gradient(90deg, #f59e0b, #fbbf24); }

        /* 服务状态区域 */
        .services-section {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            padding: 24px;
            box-shadow: var(--shadow-sm);
        }

        .services-section h3 {
            font-size: 15px; font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 16px;
        }

        .svc-list { display: flex; flex-direction: column; gap: 10px; }

        .svc-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 12px 16px;
            background: var(--stat-bg);
            border-radius: 8px;
            transition: background 0.2s;
        }

        .svc-row:hover { background: var(--accent-glow); }

        .svc-name {
            display: flex; align-items: center; gap: 10px;
            font-size: 13.5px; font-weight: 500; color: var(--text-primary);
        }

        .svc-name i { font-size: 16px; color: var(--accent); }

        .svc-badge {
            font-size: 11px; font-weight: 600;
            padding: 3px 10px;
            border-radius: 20px;
        }

        .svc-badge.online { background: rgba(16,185,129,0.1); color: #10b981; }
        .svc-badge.offline { background: rgba(239,68,68,0.1); color: #ef4444; }

        /* 登出按钮 */
        .logout-area {
            padding: 8px 12px 12px;
            border-top: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .logout-area form { display: flex; margin: 0; }

        .btn-logout {
            flex: 1;
            height: 34px;
            display: flex; align-items: center; justify-content: center; gap: 8px;
            padding: 0 10px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: transparent;
            color: var(--text-secondary);
            font-size: 13px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-logout:hover {
            color: #ef4444;
            border-color: #ef4444;
            background: rgba(239,68,68,0.05);
        }

        /* 侧边栏底部工具按钮 */
        .sidebar-footer-tools {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sf-btn {
            flex: 1;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: transparent;
            color: var(--text-muted);
            font-size: 12px;
            line-height: 1;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
            padding: 0;
        }

        .sf-btn:hover {
            color: var(--accent);
            border-color: var(--accent);
            background: var(--accent-glow);
        }

        .sf-btn i { font-size: 13px; }
        .sf-btn span { min-width: 24px; text-align: center; }
    </style>
</head>
<body>
    <!-- ==================== 侧边栏 ==================== -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="fas fa-eye"></i></div>
            <span>Aurora CV Engine</span>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section-title" data-i18n="navOverview">概览</div>
            <div class="nav-item active" data-panel="dashboard" onclick="switchPanel(this, 'dashboard')">
                <i class="fas fa-chart-pie"></i>
                <span data-i18n="navDashboard">Dashboard</span>
            </div>

            <div class="nav-section-title" data-i18n="navTools">开发工具</div>
            <div class="nav-item" data-panel="swagger" onclick="switchPanel(this, 'swagger')">
                <i class="fas fa-book"></i>
                <span data-i18n="navSwagger">Swagger API</span>
            </div>

            <div class="nav-section-title" data-i18n="navMonitor">服务监控</div>
            <div class="nav-item" data-panel="cap" onclick="switchPanel(this, 'cap')">
                <i class="fas fa-exchange-alt"></i>
                <span data-i18n="navCap">CAP 事件总线</span>
            </div>
            <div class="nav-item" data-panel="hangfire" onclick="switchPanel(this, 'hangfire')">
                <i class="fas fa-tasks"></i>
                <span data-i18n="navHangfire">Hangfire 任务</span>
            </div>
            <div class="nav-item" data-panel="profiler" onclick="switchPanel(this, 'profiler')">
                <i class="fas fa-chart-line"></i>
                <span data-i18n="navProfiler">MiniProfiler</span>
            </div>
        </nav>

        <div class="logout-area">
            <div class="sidebar-footer-tools">
                <button class="sf-btn" onclick="toggleLang()" title="切换语言">
                    <i class="fas fa-globe"></i><span id="langLabel">中文</span>
                </button>
                <button class="sf-btn" onclick="toggleTheme()" title="切换主题">
                    <i class="fas fa-circle-half-stroke"></i><span id="themeLabel">Auto</span>
                </button>
            </div>
            <form method="post" action="/monitor?handler=Logout" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout" data-i18n="logout">
                    <i class="fas fa-sign-out-alt"></i> 退出登录
                </button>
            </form>
        </div>
    </aside>

    <!-- ==================== 主区域 ==================== -->
    <div class="main-area">
        <!-- 内容面板 -->
        <div class="content-area">
            <!-- Dashboard -->
            <div class="content-panel active" id="panel-dashboard">
                <div class="dashboard-wrap">
                    <div class="dash-header">
                        <h2 data-i18n="dashTitle">服务器状态</h2>
                        <p data-i18n="dashSub">实时监控后端服务运行状况</p>
                    </div>

                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-icon cpu"><i class="fas fa-microchip"></i></div>
                            <div class="stat-label" data-i18n="cpuUsage">CPU 使用率</div>
                            <div class="stat-value" id="cpuValue">--</div>
                            <div class="progress-bar-wrap"><div class="progress-bar-fill cpu-bar" id="cpuBar" style="width:0%"></div></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon mem"><i class="fas fa-memory"></i></div>
                            <div class="stat-label" data-i18n="memUsage">内存使用</div>
                            <div class="stat-value" id="memValue">--</div>
                            <div class="stat-sub" id="memSub"></div>
                            <div class="progress-bar-wrap"><div class="progress-bar-fill mem-bar" id="memBar" style="width:0%"></div></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon disk"><i class="fas fa-hard-drive"></i></div>
                            <div class="stat-label" data-i18n="diskUsage">磁盘使用</div>
                            <div class="stat-value" id="diskValue">--</div>
                            <div class="stat-sub" id="diskSub"></div>
                            <div class="progress-bar-wrap"><div class="progress-bar-fill disk-bar" id="diskBar" style="width:0%"></div></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon os"><i class="fas fa-server"></i></div>
                            <div class="stat-label" data-i18n="osInfo">操作系统</div>
                            <div class="stat-value" id="osValue" style="font-size:15px;">--</div>
                            <div class="stat-sub" id="osSub"></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon net"><i class="fas fa-network-wired"></i></div>
                            <div class="stat-label" data-i18n="framework">.NET 运行时</div>
                            <div class="stat-value" id="fxValue" style="font-size:15px;">--</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon uptime"><i class="fas fa-clock"></i></div>
                            <div class="stat-label" data-i18n="uptime">运行时长</div>
                            <div class="stat-value" id="uptimeValue" style="font-size:16px;">--</div>
                        </div>
                    </div>

                    <div class="services-section">
                        <h3 data-i18n="svcTitle">服务端点状态</h3>
                        <div class="svc-list">
                            <div class="svc-row">
                                <div class="svc-name"><i class="fas fa-book"></i> <span>Swagger API</span></div>
                                <span class="svc-badge online" data-i18n="online">在线</span>
                            </div>
                            <div class="svc-row">
                                <div class="svc-name"><i class="fas fa-exchange-alt"></i> <span>CAP</span></div>
                                <span class="svc-badge online" data-i18n="online">在线</span>
                            </div>
                            <div class="svc-row">
                                <div class="svc-name"><i class="fas fa-tasks"></i> <span>Hangfire</span></div>
                                <span class="svc-badge online" data-i18n="online">在线</span>
                            </div>
                            <div class="svc-row">
                                <div class="svc-name"><i class="fas fa-chart-line"></i> <span>MiniProfiler</span></div>
                                <span class="svc-badge online" data-i18n="online">在线</span>
                            </div>
                            <div class="svc-row">
                                <div class="svc-name"><i class="fas fa-heartbeat"></i> <span>Health Check</span></div>
                                <span class="svc-badge" id="healthBadge">--</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Swagger -->
            <div class="content-panel" id="panel-swagger">
                <iframe src="@AuroraCVHttpApiHostConst.SwaggerUiEndPoint" loading="lazy"></iframe>
            </div>

            <!-- CAP -->
            <div class="content-panel" id="panel-cap">
                <iframe src="@AuroraCVHttpApiHostConst.CapDashboardEndPoint" loading="lazy"></iframe>
            </div>

            <!-- Hangfire -->
            <div class="content-panel" id="panel-hangfire">
                <iframe src="@AuroraCVHttpApiHostConst.HangfireDashboardEndPoint" loading="lazy"></iframe>
            </div>

            <!-- MiniProfiler -->
            <div class="content-panel" id="panel-profiler">
                <iframe src="@AuroraCVHttpApiHostConst.MiniprofilerEndPoint" loading="lazy"></iframe>
            </div>
        </div>
    </div>

    <script>
        // ==================== 面板切换 ====================
        const panelTitles = {
            'zh-CN': { dashboard: '服务器状态总览', swagger: 'Swagger API 文档与测试', cap: 'CAP 事件总线监控', hangfire: 'Hangfire 后台任务管理', profiler: 'MiniProfiler 性能分析' },
            'en': { dashboard: 'Server Dashboard', swagger: 'Swagger API Docs & Testing', cap: 'CAP Event Bus Monitor', hangfire: 'Hangfire Job Management', profiler: 'MiniProfiler Performance' }
        };

        let currentPanel = 'dashboard';

        function switchPanel(el, panel) {
            currentPanel = panel;
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            el.classList.add('active');
            document.querySelectorAll('.content-panel').forEach(p => p.classList.remove('active'));
            document.getElementById('panel-' + panel).classList.add('active');
        }

        // ==================== 多语言 ====================
        const i18n = {
            'zh-CN': {
                navOverview: '概览', navDashboard: 'Dashboard', navTools: '开发工具', navSwagger: 'Swagger API',
                navMonitor: '服务监控', navCap: 'CAP 事件总线', navHangfire: 'Hangfire 任务', navProfiler: 'MiniProfiler',
                logout: '退出登录', dashTitle: '服务器状态', dashSub: '实时监控后端服务运行状况',
                cpuUsage: 'CPU 使用率', memUsage: '内存使用', diskUsage: '磁盘使用',
                osInfo: '操作系统', framework: '.NET 运行时', uptime: '运行时长',
                svcTitle: '服务端点状态', online: '在线', offline: '离线',
                dashboardTitle: '服务器状态总览'
            },
            'en': {
                navOverview: 'OVERVIEW', navDashboard: 'Dashboard', navTools: 'DEV TOOLS', navSwagger: 'Swagger API',
                navMonitor: 'MONITORING', navCap: 'CAP Event Bus', navHangfire: 'Hangfire Jobs', navProfiler: 'MiniProfiler',
                logout: 'Sign Out', dashTitle: 'Server Status', dashSub: 'Real-time backend service monitoring',
                cpuUsage: 'CPU Usage', memUsage: 'Memory', diskUsage: 'Disk Usage',
                osInfo: 'OS', framework: '.NET Runtime', uptime: 'Uptime',
                svcTitle: 'Service Endpoints', online: 'Online', offline: 'Offline',
                dashboardTitle: 'Server Dashboard'
            }
        };

        let currentLang = localStorage.getItem('aurora-lang') || 'zh-CN';

        function applyLang(lang) {
            currentLang = lang;
            localStorage.setItem('aurora-lang', lang);
            document.getElementById('langLabel').textContent = lang === 'zh-CN' ? '中文' : 'EN';
            const texts = i18n[lang];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (texts[key]) el.textContent = texts[key];
            });
        }

        function toggleLang() { applyLang(currentLang === 'zh-CN' ? 'en' : 'zh-CN'); }

        // ==================== 明暗主题 ====================
        const themeOrder = ['light', 'dark'];
        const themeLabels = { light: 'Light', dark: 'Dark' };
        let currentThemeIdx = themeOrder.indexOf(localStorage.getItem('aurora-theme') || 'light');
        if (currentThemeIdx < 0) currentThemeIdx = 0;

        function applyTheme() {
            const mode = themeOrder[currentThemeIdx];
            localStorage.setItem('aurora-theme', mode);
            document.getElementById('themeLabel').textContent = themeLabels[mode];
            document.documentElement.setAttribute('data-theme', mode);
        }

        function toggleTheme() {
            currentThemeIdx = (currentThemeIdx + 1) % themeOrder.length;
            applyTheme();
        }

        // ==================== Dashboard 数据 ====================
        async function loadDashboard() {
            try {
                const resp = await fetch('/api/dashboard/status');
                if (!resp.ok) return;
                const d = await resp.json();

                document.getElementById('cpuValue').textContent = d.cpuUsage.toFixed(1) + '%';
                document.getElementById('cpuBar').style.width = d.cpuUsage.toFixed(1) + '%';

                const memPct = ((d.usedMemoryMB / d.totalMemoryMB) * 100).toFixed(1);
                document.getElementById('memValue').textContent = memPct + '%';
                document.getElementById('memSub').textContent = (d.usedMemoryMB / 1024).toFixed(1) + ' / ' + (d.totalMemoryMB / 1024).toFixed(1) + ' GB';
                document.getElementById('memBar').style.width = memPct + '%';

                const diskPct = ((d.usedDiskMB / d.totalDiskMB) * 100).toFixed(1);
                document.getElementById('diskValue').textContent = diskPct + '%';
                document.getElementById('diskSub').textContent = (d.usedDiskMB / 1024).toFixed(0) + ' / ' + (d.totalDiskMB / 1024).toFixed(0) + ' GB';
                document.getElementById('diskBar').style.width = diskPct + '%';

                document.getElementById('osValue').textContent = d.osDescription || '--';
                document.getElementById('osSub').textContent = d.machineName || '';
                document.getElementById('fxValue').textContent = d.frameworkDescription || '--';
                document.getElementById('uptimeValue').textContent = d.uptime || '--';

                const hb = document.getElementById('healthBadge');
                if (d.healthStatus === 'Healthy') {
                    hb.textContent = currentLang === 'zh-CN' ? '健康' : 'Healthy';
                    hb.className = 'svc-badge online';
                } else {
                    hb.textContent = currentLang === 'zh-CN' ? '异常' : 'Unhealthy';
                    hb.className = 'svc-badge offline';
                }
            } catch { /* 静默失败 */ }
        }

        // 初始化
        applyTheme();
        applyLang(currentLang);
        loadDashboard();
        setInterval(loadDashboard, 5000);
    </script>
</body>
</html>
