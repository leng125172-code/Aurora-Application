<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\..\common.props" />
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <RootNamespace>AuroraStruct3D.HttpApi.Client.ConsoleTestApp</RootNamespace>
        <Description>"Aurora Struct3D HTTP Client Console测试应用，用于演示 HTTP 客户端的使用。"</Description>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Volo.Abp.Http.Client.IdentityModel" />
        <ProjectReference Include="..\..\..\Sources\AuroraStruct3D\AuroraStruct3D.HttpApi.Client\AuroraStruct3D.HttpApi.Client.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    </ItemGroup>
</Project>