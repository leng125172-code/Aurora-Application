<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>TucamGenICamTest</RootNamespace>
        <AssemblyName>TucamGenICamTest</AssemblyName>
        <RuntimeIdentifiers>linux-arm64;win-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <!-- Windows x64：自动将 TUCam SDK 运行时 DLL 复制到输出目录 -->
    <ItemGroup Condition="Exists('C:\Program Files (x86)\TUCam_SDK\runtime\x64_all')">
        <None Include="C:\Program Files (x86)\TUCam_SDK\runtime\x64_all\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Linux ARM64：复制 aarch64 共享库 -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-arm64'">
        <None Include="$(MSBuildThisFileDirectory)..\..\Documents\TUCam_aarch64\lib\*.so*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <TargetPath>%(Filename)%(Extension)</TargetPath>
        </None>
    </ItemGroup>

    <!-- 图像处理：OpenCV（替代 GDI+，同时支持自动曝光分析） -->
    <ItemGroup>
        <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
        <!-- Windows 运行时：包含 OpenCV 原生 DLL -->
        <PackageReference
            Include="OpenCvSharp4.runtime.win"
            Version="4.10.0.20241108"
            Condition="'$(OS)' == 'Windows_NT'"
        />
    </ItemGroup>
</Project>
