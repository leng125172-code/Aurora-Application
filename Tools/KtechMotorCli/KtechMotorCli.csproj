<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>KtechMotorCli</RootNamespace>
        <AssemblyName>KtechMotorCli</AssemblyName>
        <!-- 不进入解决方案，仅作独立调试工具；如需可手动 dotnet sln add -->
        <RuntimeIdentifiers>win-x64;linux-arm64</RuntimeIdentifiers>
        <!-- 屏蔽 AbpPro 项目继承自 common.props 的强校验，避免阻塞独立工具构建 -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- 直接复用 AuroraStruct3D.RS485 中已实现的 KTECH 协议栈 -->
        <ProjectReference Include="..\..\Sources\AuroraStruct3D\AuroraStruct3D.RS485\AuroraStruct3D.RS485.csproj" />
    </ItemGroup>
</Project>
