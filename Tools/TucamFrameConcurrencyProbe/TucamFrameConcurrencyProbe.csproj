<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifiers>linux-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="Exists('C:\Program Files (x86)\TUCam_SDK\runtime\x64_all')">
    <None Include="C:\Program Files (x86)\TUCam_SDK\runtime\x64_all\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.2" />
    <Compile Include="..\FringeTool\HidProjectorClient.cs" Link="HidProjectorClient.cs" />
  </ItemGroup>
</Project>
