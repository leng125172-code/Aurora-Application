<!--
  common.props 文件
  功能：定义 Aurora Application 项目的公共属性和配置
  用途：作为项目的共享配置文件，确保所有子项目使用一致的设置
-->
<Project>
    <PropertyGroup>
        <Platforms>AnyCPU;x64;x86;arm64</Platforms>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <RuntimeIdentifiers>win-x64;win-x86;linux-arm64</RuntimeIdentifiers>

        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>preview</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InvariantGlobalization>false</InvariantGlobalization>

        <AssemblyTitle>$(RootNamespace)</AssemblyTitle>
        <Company>三花装备事业部 C Sharp 开发团队</Company>
        <Copyright>©2002-$([System.DateTime]::Now.ToString(`yyyy`)) 三花装备事业部</Copyright>

        <!-- 🔥 修复：XML 转义双引号，不再报错 -->
        <VersionPrefix>0.1</VersionPrefix>
        <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.Md`))</VersionSuffix>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <FileVersion>$(Version)</FileVersion>
        <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(`yyyy.Md`))</AssemblyVersion>

        <PackageId>$(RootNamespace)</PackageId>
        <Authors>$(Company)</Authors>
        <RepositoryType>git</RepositoryType>
        <PackageTags>$(Company);$(AssemblyName)</PackageTags>
        <PackageReleaseNotes>$(Description)</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>Readme.MD</PackageReadmeFile>
        <NuGetAuditMode>all</NuGetAuditMode>
        <DefaultLanguage>zh-hans</DefaultLanguage>

        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS*;SYSLIB*;NETSDK*;CA*</NoWarn>
        <NuGetIgnoreWarning>NU*</NuGetIgnoreWarning>
        <NoWarn>$(NoWarn);NU1510;NU1701;NU1902;NU1903;NU1904</NoWarn>

        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <AnalysisLevel>none</AnalysisLevel>

        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <ApplicationIcon>Assets/Application.ico</ApplicationIcon>
        <PackageIcon>Assets/Application.png</PackageIcon>

        <!-- 自动按平台发布，不覆盖、不冲突 -->
        <PublishDir>..\..\..\Publish\$(RuntimeIdentifier)\$(RootNamespace)</PublishDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <OutputPath>..\..\..\Builds\Debug\$(RootNamespace)</OutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <OutputPath>..\..\..\Builds\Release\$(RootNamespace)</OutputPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true' AND '$(UsingMicrosoftNETSdkRazor)' != 'true'">
        <None Remove="*.abppkg.analyze.json" />
        <Content Include="*.abppkg.analyze.json">
            <Pack>true</Pack>
            <PackagePath>content\</PackagePath>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe'">
        <Content Include="Assets\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <!-- 类库项目 → 清空 Assets 避免冲突 -->
    <ItemGroup Condition="'$(OutputType)' != 'Exe' And '$(OutputType)' != 'WinExe'">
        <Content Remove="Assets\*" />
        <None Remove="Assets\*" />
    </ItemGroup>
</Project>
