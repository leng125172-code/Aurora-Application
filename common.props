<!--
  common.props 文件
  功能：定义 Aurora Application 项目的公共属性和配置
  用途：作为项目的共享配置文件，确保所有子项目使用一致的设置
-->
<Project>
    <!-- 主要属性组：定义项目的基本配置 -->
    <PropertyGroup>
        <!-- Platforms 平台：支持的目标平台 -->
        <Platforms>x86;x64;arm64</Platforms>
        <!-- Implicit Usings 全局引用：启用 C# 10+ 的全局 using 指令 -->
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- 语言版本：使用当前 .NET SDK 所支持的最新 C# 语言版本 -->
        <LangVersion>preview</LangVersion>
        <!-- Nullable 可为空警告：启用可为空引用类型检查 -->
        <Nullable>enable</Nullable>
        <!-- 允许不安全代码：允许使用 unsafe 代码块 -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- 禁用全球化不变模式，确保多语言区域性支持正常工作 -->
        <InvariantGlobalization>false</InvariantGlobalization>

        <!-- 软件信息：定义程序集的元数据 -->
        <AssemblyTitle>$(RootNamespace)</AssemblyTitle>
        <Company>三花装备事业部 C Sharp 开发团队</Company>
        <Copyright>©2002-$([System.DateTime]::Now.ToString(`yyyy`)) 三花装备事业部</Copyright>

        <!-- 版本信息：使用前缀 + 日期格式的版本号 -->
        <VersionPrefix>0.1</VersionPrefix>
        <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.Md`))</VersionSuffix>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <FileVersion>$(Version)</FileVersion>
        <AssemblyVersion>$(VersionPrefix).$([System.DateTime]::Now.ToString(`yyyy.Md`))</AssemblyVersion>

        <!-- 包信息：定义 NuGet 包的元数据 -->
        <PackageId>$(RootNamespace)</PackageId>
        <Authors>$(Company)</Authors>
        <RepositoryType>git</RepositoryType>
        <PackageTags>$(Company);$(AssemblyName)</PackageTags>
        <PackageReleaseNotes>$(Description)</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PackageReadmeFile>Readme.MD</PackageReadmeFile>
        <NuGetAuditMode>all</NuGetAuditMode>
        <DefaultLanguage>zh-hans</DefaultLanguage>

        <!-- 锁死 1：禁用所有警告转为错误 -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>false</MSBuildTreatWarningsAsErrors>

        <!-- 锁死 2：屏蔽所有编译器警告 CSxxx SYSLIBxxx -->
        <NoWarn>$(NoWarn);CS*;SYSLIB*;NETSDK*;CA*</NoWarn>

        <!-- 锁死 3：屏蔽所有 NuGet 警告 NUxxx -->
        <NuGetIgnoreWarning>NU*</NuGetIgnoreWarning>
        <NoWarn>$(NoWarn);NU1510;NU1701;NU1902;NU1903;NU1904</NoWarn>

        <!-- 锁死 4：彻底关闭分析器 -->
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <AnalysisLevel>none</AnalysisLevel>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <!-- Debug 配置：定义调试模式下的输出路径 -->
    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <!-- Debug Output Path 输出路径：调试构建的输出目录 -->
        <OutputPath>..\..\..\Builds\Debug\$(RootNamespace)</OutputPath>
    </PropertyGroup>

    <!-- Release 配置：定义发布模式下的输出路径 -->
    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <!-- Release Output Path 输出路径：发布构建的输出目录 -->
        <OutputPath>..\..\..\Builds\Release\$(RootNamespace)</OutputPath>
    </PropertyGroup>

    <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true' AND '$(UsingMicrosoftNETSdkRazor)' != 'true'">
        <None Remove="*.abppkg.analyze.json" />
        <Content Include="*.abppkg.analyze.json">
            <Pack>true</Pack>
            <PackagePath>content\</PackagePath>
        </Content>
    </ItemGroup>
</Project>
